# Webhook SePay tu dong duyet don (server-only, TUYET DOI khong them NEXT_PUBLIC_)
# Lay sb_secret_... tai Supabase Dashboard → Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=sb_secret_thay-bang-key-that
# Chuoi bi mat tu dat (vd: openssl rand -hex 32), dan vao URL webhook tren sepay.vn
SEPAY_WEBHOOK_SECRET=thay-bang-chuoi-ngau-nhien-dai

